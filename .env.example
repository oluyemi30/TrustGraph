# =========================================================================
# TrustGraph — Robinhood Chain Testnet & Server Configuration
# Copy this file to `.env` for local development. Never commit real secrets.
# =========================================================================

NODE_ENV=development
PORT=3000

# -------------------------------------------------------------------------
# Robinhood Chain Testnet (Primary On-Chain Network — Required Defaults)
# -------------------------------------------------------------------------
RH_CHAIN_ID=46630
# Public testnet RPC for development; use a dedicated RPC provider URL in production
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
RH_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com

# Deployed TrustGraphRegistry address on Robinhood Chain Testnet (Optional until deployed; required for on-chain attestations & indexing)
RH_REGISTRY_ADDRESS=

# Optional client-side overrides (Vite exposes only VITE_* variables; NEVER put private keys in VITE_*!)
VITE_RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
VITE_RH_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
VITE_RH_REGISTRY_ADDRESS=

# -------------------------------------------------------------------------
# Contract Deployment Only (NEVER set on routine web servers or commit to git)
# Pass only in local CLI / secure CI when running `npm run deploy:testnet`:
# DEPLOYER_PRIVATE_KEY=
# -------------------------------------------------------------------------

# -------------------------------------------------------------------------
# Optional Integrations & Security
# -------------------------------------------------------------------------
# Telegram Bot Token from @BotFather (Optional: enables live Telegram polling)
TELEGRAM_BOT_TOKEN=

# Gemini API Key (Optional: enables AI risk & consensus interpretations; falls back to deterministic local heuristics if unset)
GEMINI_API_KEY=

# Intuition Protocol API Key (Optional: supplementary external Base/Intuition GraphQL data source)
INTUITION_API_KEY=
# Set to "true" only in local development if you want sample Intuition data when external GraphQL is unreachable
ALLOW_INTUITION_SAMPLE_FALLBACK=false

# Comma-separated allowed CORS origins for split static/backend hosting (e.g. https://trustgraph.example.com)
CORS_ALLOWED_ORIGINS=
