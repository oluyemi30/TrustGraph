{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "compile:contracts": "tsx scripts/compile-contracts.ts",
    "test:contracts": "tsx --test test/TrustGraphRegistry.test.ts",
    "test:backend": "tsx --test test/backend.test.ts",
    "test": "npm run compile:contracts && npm run test:contracts && npm run test:backend",
    "deploy:testnet": "tsx scripts/deploy-testnet.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@intuitionmachine/sdk": "file:./shims/intuition-sdk",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.16.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ethereumjs/vm": "8.1.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "solc": "0.8.28",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
